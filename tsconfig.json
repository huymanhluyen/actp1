{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": ["global-setup.ts", "account.ts", 
    "tests/**/*.ts",
    "reporters/**/*.ts",
    "playwright.config.ts"
  ]
}